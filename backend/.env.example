APP_NAME="LLM Decision Reliability Lab"
ENVIRONMENT=development
DATABASE_URL=sqlite:///./reliability_lab.db
OPENAI_API_KEY=

# Safety guardrail: reject experiment execution if the planned run count
# (dataset items x prompt versions x model names x repeat count) exceeds this.
MAX_RUNS_PER_EXPERIMENT=30

# Comma-separated list of origins allowed to call this API via CORS (the
# local Next.js dev server). No wildcards -- credentials are never allowed.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
